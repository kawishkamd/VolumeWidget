<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VolumeWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#455A64</item>
        <item name="colorPrimaryVariant">#37474F</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#78909C</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Match status bar to background -->
        <item name="android:statusBarColor">?android:attr/windowBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>