<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VolumeWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#90A4AE</item>
        <item name="colorPrimaryVariant">#78909C</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">#78909C</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Match status bar to background -->
        <item name="android:statusBarColor">?android:attr/windowBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>