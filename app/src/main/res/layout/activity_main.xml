<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_volume_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/volume_level"
        android:textSize="24sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_volume_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/volume_up"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_volume_down"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/volume_down"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/support_creator"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btn_github"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/github_repo"
        android:backgroundTint="#24292e"
        android:textColor="@android:color/white"
        android:layout_marginTop="8dp" />

</LinearLayout>
